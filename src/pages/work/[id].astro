---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const work = await getCollection('work', ({ data }) => !data.draft);
  return work.map((item) => ({ params: { id: item.id }, props: { item } }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const d = item.data;
---
<Base title={`${d.title} — Sergio Wizenfeld`} description={d.outcome}>
  <article class="wrap">
    <header class="cs-head">
      <a class="back" href="/#work">All work</a>
      <h1>{d.title}</h1>
      <p class="outcome">{d.tagline ?? d.outcome}</p>
      <dl class="facts">
        <div><dt>Company</dt><dd>{d.company}</dd></div>
        <div><dt>My role</dt><dd>{d.role}</dd></div>
        {d.team && <div><dt>Team</dt><dd>{d.team}</dd></div>}
        <div><dt>Year</dt><dd>{d.year}</dd></div>
      </dl>
    </header>
    {d.cover && <img class="cover" src={d.cover} alt={`${d.title} cover`} />}
    {d.impact.length > 0 && (
      <section class="impact" aria-label="Results">
        {d.impact.map((m) => (
          <div>
            <p class="num">{m.value}</p>
            <p class="lbl">{m.label}</p>
          </div>
        ))}
      </section>
    )}
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .cs-head { padding-block: clamp(2rem, 7vw, 5rem) 2.5rem; }
  .back { color: var(--slate); }
  h1 {
    font-size: var(--step-4);
    line-height: 1.04;
    letter-spacing: -0.035em;
    margin: 1.5rem 0 1rem;
  }
  .outcome {
    font-size: var(--step-2);
    line-height: 1.3;
    max-width: 30ch;
    margin: 0;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: 1rem 2rem;
    margin: 2.5rem 0 0;
    padding-top: 1.25rem;
    border-top: 2px solid var(--ink);
  }
  dt { color: var(--slate); font-size: var(--step--1); }
  dd { margin: 0.15rem 0 0; font-weight: 600; }
  .cover { width: 100%; margin-bottom: 3rem; border-radius: 6px; }
  .prose { max-width: 40rem; }
  .prose :global(h2) {
    font-size: var(--step-2);
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin: 3rem 0 0.75rem;
  }
  .impact {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 1.5rem 2rem;
    margin: 0 0 3.5rem;
  }
  .impact p { margin: 0; }
  .num {
    font-size: var(--step-3);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--cobalt);
    font-variant-numeric: tabular-nums;
  }
  .lbl { color: var(--slate); max-width: 22ch; margin-top: 0.35rem !important; }
  .prose :global(h3) {
    font-size: var(--step-1);
    line-height: 1.3;
    margin: 1.75rem 0 0.35rem;
  }
  .prose :global(h3 + p) { margin-top: 0; }
  .prose :global(p),
  .prose :global(li) { max-width: 66ch; }
  .prose :global(img) { margin-block: 2rem; border-radius: 6px; }
  .prose :global(a) { color: var(--cobalt); }
</style>
